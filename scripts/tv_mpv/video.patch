diff --git a/scripts/build_libmpv_tizen.sh b/scripts/build_libmpv_tizen.sh
index 2ed2af9..f6fcad2 100644
--- a/scripts/build_libmpv_tizen.sh
+++ b/scripts/build_libmpv_tizen.sh
@@ -124 +124,5 @@ setup_toolchain() {
-exec $tool --target=$CLANG_TARGET --sysroot="$SYSROOT" $ABI_FLAGS -fuse-ld=lld -Wno-unused-command-line-argument "\$@"
+case " \$* " in
+  *" -c "*|*" -E "*|*" -S "*) linker= ;;
+  *) linker=-fuse-ld=lld ;;
+esac
+exec $tool --target=$CLANG_TARGET --sysroot="$SYSROOT" $ABI_FLAGS \$linker -Wno-unused-command-line-argument "\$@"
diff --git a/scripts/shared/_audio_only.sh b/scripts/shared/_audio_only.sh
index 825168d..c6a4de2 100644
--- a/scripts/shared/_audio_only.sh
+++ b/scripts/shared/_audio_only.sh
@@ -754,0 +755 @@ ${_small_flag}
+--enable-libdav1d
@@ -974,7 +975,7 @@ verify_ffmpeg_config() {
-  # Audio-only invariant: the 4 most common video decoders MUST be off.
-  # If one is present, the binary is at least 30% larger than necessary
-  # (and the audio-only branding is a lie).
-  assert_define "$cmp" "CONFIG_H264_DECODER" "0"
-  assert_define "$cmp" "CONFIG_HEVC_DECODER" "0"
-  assert_define "$cmp" "CONFIG_VP9_DECODER"  "0"
-  assert_define "$cmp" "CONFIG_AV1_DECODER"  "0"
+  # The TV renderer needs both the compatibility decoders and hardware wrappers.
+  assert_define "$cmp" "CONFIG_H264_V4L2M2M_DECODER" "1"
+  assert_define "$cmp" "CONFIG_LIBDAV1D_DECODER" "1"
+  assert_define "$cmp" "CONFIG_H264_DECODER" "1"
+  assert_define "$cmp" "CONFIG_HEVC_DECODER" "1"
+  assert_define "$cmp" "CONFIG_VP9_DECODER"  "1"
+  assert_define "$cmp" "CONFIG_AV1_DECODER"  "1"
@@ -1538 +1539 @@ dep_unwind_cflags() {
-MPV_SONAME="libmpv_audio_kit.so"
+MPV_SONAME="libpleazyng_tv_mpv.so"
diff --git a/scripts/shared/_cross.sh b/scripts/shared/_cross.sh
index 049294f..4187ce0 100644
--- a/scripts/shared/_cross.sh
+++ b/scripts/shared/_cross.sh
@@ -408,0 +409,5 @@ cross_build_libplacebo() {
+  # Use libplacebo's portable float formatter on older webOS libstdc++.
+  if [[ "${NDK_TRIPLE:-}" == "arm-webosmllib32-linux-gnueabi" ]]; then
+    sed -i '1i #define HAS_STD_TO_CHARS_FP 0' "$gitdir/src/convert.cc"
+    sed -i 's/= has_std_from_chars_impl<T>::value;/= !std::is_floating_point_v<T> \&\& has_std_from_chars_impl<T>::value;/' "$gitdir/src/convert.cc"
+  fi
@@ -456,0 +462,8 @@ cross_build_ffmpeg() {
+  local dav_tar="$CROSS_BUILD_DIR/src/dav1d-1.5.1.tar.xz"
+  download "https://download.videolan.org/pub/videolan/dav1d/1.5.1/dav1d-1.5.1.tar.xz" "$dav_tar"
+  local dav_src; dav_src="$(extract "$dav_tar" "$CROSS_BUILD_DIR/src")"
+  local dav_build; dav_build="$(cross_bdir dav1d)"
+  meson setup "$dav_build" "$dav_src" --cross-file "$CROSS_MESON_FILE" \
+    --prefix "$CROSS_PREFIX_DIR" --libdir lib --default-library=static \
+    -Db_staticpic=true -Denable_tools=false -Denable_tests=false
+  ninja -C "$dav_build" -j"$JOBS" install
@@ -483,0 +497,3 @@ cross_mpv_source() {
+  if [[ "${NDK_TRIPLE:-}" == "arm-webosmllib32-linux-gnueabi" ]]; then
+    python3 "$PLEAZYNG_TV_MPV_SOURCE/install_ndl.py" "$CROSS_MPV_DIR"
+  fi
