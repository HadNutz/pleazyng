+  assert_define "$cmp" "CONFIG_LIBDAV1D_DECODER" "1"
+  assert_define "$cmp" "CONFIG_H264_DECODER" "1"
+  assert_define "$cmp" "CONFIG_HEVC_DECODER" "1"
