# Paymentwall remains disabled until merchant approval, Status API activation,
# billing.pleazyng.app HTTPS routing, and server signing-key configuration.
LG_PAYMENTWALL_ENABLED=false
LG_PAYMENTWALL_TEST_PINGBACK_ENABLED=false
LG_PAYMENTWALL_STATUS_API_ENABLED=false
LG_PAYMENTWALL_PROJECT_KEY=
LG_PAYMENTWALL_SECRET_KEY=
LG_PAYMENTWALL_PUBLIC_BASE_URL=https://billing.pleazyng.app
LG_PAYMENTWALL_STATE_FILE=/data/lg-paymentwall.json
LG_PAYMENTWALL_GRANT_PRIVATE_KEY=
LG_PAYMENTWALL_ALLOW_SIG_V2=false
LG_PAYMENTWALL_ALLOWED_ORIGINS=https://billing.pleazyng.app
